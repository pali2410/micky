# Copy to .env.local; choose models actually installed in your local service.
BOPS_LOCAL_LLM_URL=http://127.0.0.1:11434/v1
BOPS_LOCAL_MODEL=qwen2.5:3b
BOPS_WORKER_MODEL=phi4-mini:latest
BOPS_REASONING_MODEL=phi4-mini:latest
BOPS_VISION_MODEL=qwen2.5vl:3b
BOPS_TOOL_MODEL=qwen2.5:3b
BOPS_HARNESS_PORT=8766
BOPS_HARNESS_URL=http://127.0.0.1:8766
# Optional DeepSeek SDK modes; leaving these unset uses the native planner.
# BOPS_PLANNER_ENGINE=deepseek
# BOPS_REASONING_ENGINE=deepseek
# BOPS_EXECUTION_ENGINE=deepseek
# MICKY_PYTHON=C:/path/to/python.exe
# MICKY_NODE=C:/path/to/node.exe
# BOPS_CHROME_PROFILE_EMAIL=you@example.com
