+        if (!response.ok) throw new ProviderError(`Local vision rejected the screenshot (${response.status}).`, 'Vision failed');
+        const description = (await response.json()).choices?.[0]?.message?.content;
+        if (!description) throw new ProviderError('Local vision returned no description.', 'Vision failed');
+        message.content[i] = { type: 'text', text: `[Screenshot observation from ${vision}; semantic element IDs must come from read_screen]\n${description}` };
+      }
+    }
+  }
+
   requestExtras() {
     return { ...SAMPLING, max_tokens: 2048, parallel_tool_calls: true };
